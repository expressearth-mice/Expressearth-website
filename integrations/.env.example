# Copy to integrations/.env (gitignored) for local development.
# In Cloud Run the secrets come from GCP Secret Manager instead -- see
# apollo_smartlead/README.md. Never put real keys in this example file.

APOLLO_API_KEY=
APOLLO_WEBHOOK_SECRET=
APOLLO_DAILY_CREDIT_LIMIT=100

SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=
SMARTLEAD_SIGNING_SECRET=
# Safety gates: keep 0 until approval, suppression and sender-domain checks are done.
SMARTLEAD_WRITE_ENABLED=0
SMARTLEAD_SENDING_ENABLED=0

LEADGEN_PUBLIC_BASE_URL=

EMPFLY_AUTH_BASE_URL=
EMPFLY_CRM_BASE_URL=
EMPFLY_CRM_EMAIL=
EMPFLY_CRM_PASSWORD=
EMPFLY_CRM_ORG_ID=
EMPFLY_CRM_LEAD_SOURCE_ID=
EMPFLY_CRM_USE_CUSTOM_FIELDS=0
EMPFLY_CRM_SYNC_ENABLED=0
